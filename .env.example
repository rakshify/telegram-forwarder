# Telegram API credentials (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# Where session files are stored inside the container.
# This directory is mounted as a Docker volume in docker-compose.yml.
SESSION_DIR=/data/sessions

# Optional: Signal destinations for the WhatsApp bridge (README §12).
# The number (+ and country code) of the Signal account set up in
# signal-cli-rest-api, and where that API answers.
SIGNAL_SENDER=
SIGNAL_API_URL=http://signal-api:8080
